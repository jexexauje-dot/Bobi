GEMINI_API_KEY_TEXT=       # clé pour texte + gestes (https://aistudio.google.com/apikey). Vide = mode MOCK
GEMINI_API_KEY_TTS=        # clé pour la voix (vide = réutilise la clé texte)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts   # vérifie le nom actuel dans AI Studio
GEMINI_TTS_VOICE=Charon    # voix masculine posée ; autres : Puck, Fenrir, Orus...
TTS_DAILY_CAP=60           # phrases vocales max par utilisateur et par jour
YOUTUBE_API_KEY=           # optionnel
ALLOWED_ORIGIN=*           # en production : l'URL exacte de ton site
PORT=8787
# --- Sources d'images optionnelles (gratuites, à ajouter si tu veux plus de résultats) ---
PEXELS_API_KEY=       # optionnel (pexels.com/api)
UNSPLASH_ACCESS_KEY=  # optionnel (unsplash.com/developers)
PIXABAY_KEY=          # optionnel (pixabay.com/api/docs)
GEMINI_IMAGE_MODEL=   # optionnel, défaut gemini-2.5-flash-image
# --- Génération d'images (essayées dans cet ordre ; Pollinations sert de secours sans clé) ---
GEMINI_API_KEY_IMAGE= # optionnel : une clé d'un AUTRE projet Google AI Studio, pour que les images n'usent pas le quota du texte
CLOUDFLARE_ACCOUNT_ID=  # optionnel : Workers AI (FLUX), gratuit
CLOUDFLARE_API_TOKEN=   # optionnel : token Workers AI
HF_TOKEN=               # optionnel : Hugging Face (FLUX.1-schnell), gratuit
